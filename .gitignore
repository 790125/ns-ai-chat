# ============================================================
# Visual Studio 生成的文件（巨大且包含机器信息）
# ============================================================
.vs/
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# ============================================================
# C/C++ 编译产物（这些可以随时重新编译，不应该上传）
# ============================================================
# 中间文件
*.obj
*.o
*.lo
*.la
*.al
*.ilk
*.i
*.ii
*.ipdb

# 调试/发布目录
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww]in32/
[Aa]rm/
[Aa]rm64/
build/
build_switch/
out/

# 编译产物（二进制文件）
*.exe
*.dll
*.so
*.dylib
*.elf
*.nro
*.nso
*.nro.json
*.kip
*.nacp
*.npdm
*.map

# 调试符号
*.pdb
*.idb

# 预编译头
*.pch
*.ipch
*.gch

# 编译日志
*.log
*.tlog/

# Visual Studio 缓存
*.VC.db
*.VC.opendb
[Bb]rowse.VC.db
*.vsidx
DocumentLayout.json
DocumentLayout.backup.json

# Copilot 索引
CopilotIndices/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# ============================================================
# 敏感信息 — 绝对不能上传
# ============================================================
# 任何包含 API Key 的配置文件
.env
.env.*
*.secret
secrets.json
config.local.*

# ============================================================
# 系统文件
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~